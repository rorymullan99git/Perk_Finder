# Public (safe to expose to browsers). Only needed for `npm run seed:check`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# SECRET. Server/CLI only, used by the seed scripts to write data.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
